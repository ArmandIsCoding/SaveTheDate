@page "/administracion/eventos/{Id:guid}"
<PageTitle>@(Data?.Event.Title ?? "Evento") · Administración</PageTitle>
@if (Data is null) { <div class="admin-empty"><h1>No encontramos este evento.</h1><p>Puede que ya no esté disponible.</p><a class="button secondary" href="/administracion/eventos">Volver a eventos</a></div> }
else
{
    var item = Data.Event;
    <a href="/administracion/eventos?usuario=@Uri.EscapeDataString(item.OwnerId)" class="admin-back"><Icon Name="back" /> Eventos de @Data.OwnerName</a>
    <div class="admin-heading"><div><span class="eyebrow">UNA HISTORIA, TODOS SUS DETALLES</span><h1>@item.Title</h1><p>Organizado por @Data.OwnerName · @Data.OwnerEmail</p></div><span class="admin-badge @AdminFormat.StatusClass(item.IsPublished, item.IsDeleted)">@AdminFormat.Status(item.IsPublished, item.IsDeleted)</span></div>
    <section class="admin-event-overview admin-panel"><img class="admin-cover" src="@(item.CoverImageId.HasValue ? "/administracion/media/" + item.CoverImageId : item.CoverUrl)" alt="Portada de @item.Title" /><div class="admin-event-info"><span class="eyebrow">@ModuleCatalog.KindName(item.Kind)</span><h2>@item.LocalDate.ToString("d 'de' MMMM 'de' yyyy")</h2><p><Icon Name="clock" /> @item.LocalDate.ToString("HH:mm") hs · @item.TimeZoneId</p><p><Icon Name="pin" /> @(string.IsNullOrWhiteSpace(item.Venue) ? "Lugar por definir" : item.Venue)</p><dl><div><dt>Creado</dt><dd>@AdminFormat.Local(item.CreatedAtUtc).ToString("dd/MM/yyyy · HH:mm") (Argentina)</dd></div><div><dt>Paleta</dt><dd>@Palette(item.Palette)</dd></div><div><dt>Enlace</dt><dd>/i/@item.Slug</dd></div></dl>@if (item.IsPublished && !item.IsDeleted) { <a href="/i/@item.Slug" target="_blank" rel="noopener" class="button secondary">Ver invitación pública <Icon Name="arrow" /></a> } else { <span class="admin-muted-note">Esta invitación no está disponible al público.</span> }</div></section>
    <section class="admin-metrics compact" aria-label="Resumen del evento"><div class="admin-metric"><span>Módulos activos</span><strong>@item.Modules.Count(m => m.Enabled)<small>/ @item.Modules.Count</small></strong></div><div class="admin-metric"><span>Fotos en galería</span><strong>@item.Gallery.Images.Count</strong></div><div class="admin-metric"><span>Respuestas recibidas</span><strong>@Data.Responses.Total</strong></div><div class="admin-metric"><span>Asistentes confirmados</span><strong>@Data.Guests</strong></div></section>
    <section class="admin-panel"><div class="admin-panel-heading"><div><span class="eyebrow">CÓMO ESTÁ ARMADA SU INVITACIÓN</span><h2>Diseño y módulos</h2></div><span class="admin-badge neutral">Consulta</span></div><div class="admin-modules">
        @foreach (var module in item.Modules.OrderBy(m => m.Position))
        {
            <details class="admin-module"><summary><span class="admin-module-icon"><Icon Name="@ModuleCatalog.Get(module.Kind).Icon" /></span><span><strong>@ModuleCatalog.Get(module.Kind).Name</strong><small>@module.Title</small></span><span class="admin-badge @(module.Enabled ? "published" : "neutral")">@(module.Enabled ? "Activo" : "Oculto")</span></summary><div class="admin-module-body">@if (!string.IsNullOrWhiteSpace(module.Body)) { <p>@module.Body</p> }@if (!string.IsNullOrWhiteSpace(module.Detail)) { <p>@module.Detail</p> }@if (!string.IsNullOrWhiteSpace(module.LinkUrl) && ModuleCatalog.SafeUrl(module.LinkUrl)) { <a href="@module.LinkUrl" target="_blank" rel="noopener noreferrer">@(string.IsNullOrWhiteSpace(module.ButtonText) ? "Abrir enlace del módulo" : module.ButtonText) <Icon Name="arrow" /></a> }@if (string.IsNullOrWhiteSpace(module.Body) && string.IsNullOrWhiteSpace(module.Detail) && string.IsNullOrWhiteSpace(module.LinkUrl)) { <p>Esta sección utiliza su contenido predeterminado o los datos del evento.</p> }</div></details>
        }
    </div></section>
    <section class="admin-panel"><div class="admin-panel-heading"><div><span class="eyebrow">LOS RECUERDOS QUE ELIGIERON</span><h2>Galería de fotos</h2></div><span class="admin-badge neutral">@item.Gallery.Images.Count imágenes</span></div>@if (item.Gallery.Images.Count == 0) { <div class="admin-empty"><Icon Name="image" /><p>Esta galería todavía está esperando sus primeras fotos.</p></div> } else { <div class="admin-gallery">@foreach (var photo in item.Gallery.Images.OrderBy(p => p.Position)) { <figure><a href="/administracion/media/@photo.Id" target="_blank" rel="noopener"><img src="/administracion/media/@photo.Id" alt="@(string.IsNullOrWhiteSpace(photo.Caption) ? "Foto de " + item.Title : photo.Caption)" loading="lazy" /></a><figcaption>@(string.IsNullOrWhiteSpace(photo.Caption) ? "Sin descripción" : photo.Caption) @if (item.CoverImageId == photo.Id) { <span class="admin-badge published">Portada</span> }</figcaption></figure> }</div> }</section>
    <section class="admin-panel admin-table-panel" id="asistencia"><div class="admin-panel-heading"><div><span class="eyebrow">RESPUESTAS PRIVADAS DEL EVENTO</span><h2>Quiénes van a acompañar</h2></div><span class="admin-muted-note">@Data.Declined respuestas de no asistencia</span></div>
        @if (Data.Responses.Total == 0) { <div class="admin-empty"><Icon Name="heart" /><p>Todavía no se recibieron respuestas de asistencia.</p></div> }
        else { <div class="admin-table-scroll" role="region" aria-label="Respuestas de asistencia" tabindex="0"><table class="admin-table"><thead><tr><th>Invitado / Correo</th><th>Respuesta</th><th>Personas</th><th>Mensaje</th><th>Recibida</th></tr></thead><tbody>@foreach (var response in Data.Responses.Items) { <tr><td><strong>@response.Name</strong><small>@response.Email</small></td><td><span class="admin-badge @(response.Attending ? "published" : "neutral")">@(response.Attending ? "Asiste" : "No asiste")</span></td><td>@(response.Attending ? response.PartySize : 0)</td><td class="admin-guest-note">@(string.IsNullOrWhiteSpace(response.Note) ? "—" : response.Note)</td><td>@AdminFormat.Local(response.UpdatedAtUtc).ToString("dd/MM/yyyy")<small>@AdminFormat.Local(response.UpdatedAtUtc).ToString("HH:mm") (Argentina)</small></td></tr> }</tbody></table></div><AdminPagination Total="Data.Responses.Total" Page="Data.Responses.Page" Pages="Data.Responses.Pages" Link="PageUrl" /> }
    </section>
}
@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "pagina")] public int Page { get; set; } = 1;
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    private AdminEventDetail? Data;
    protected override async Task OnParametersSetAsync() { Data = await Admin.EventAsync(Id, Page); if (Data is null && HttpContext is not null) HttpContext.Response.StatusCode = 404; }
    private string PageUrl(int page) => $"/administracion/eventos/{Id}?pagina={page}#asistencia";
    private static string Palette(string value) => value switch { "rose" => "Rosa acuarela", "sage" => "Jardín de salvia", "lavender" => "Sueño lavanda", _ => value };
}
