@page "/ayuda"
@attribute [Authorize]
<PageTitle>Primeros pasos · SaveTheDate</PageTitle>
<header class="topbar"><div class="breadcrumb">Mi espacio <span>/</span> <strong>Primeros pasos</strong></div></header><div class="page-content" id="page-content"><section class="page-heading"><div><span class="eyebrow">TE ACOMPAÑAMOS EN CADA PASO</span><h1>De una idea a un encuentro<span class="serif-dot">.</span></h1><p>Todo lo que necesitás para empezar a compartir tu historia.</p></div></section><div class="help-steps">@foreach (var step in steps.Select((value, index) => new { value, index })) { <article class="panel"><span class="step-number">0@(step.index + 1)</span><div><h2>@step.value.Item1</h2><p>@step.value.Item2</p></div></article> }</div><a href="/eventos" class="button primary">Ir a mis eventos <Icon Name="arrow" /></a></div>
@code { readonly (string, string)[] steps = [("Poné una fecha a tu historia", "Creá un evento con su nombre, tipo de celebración y fecha. Arranca como borrador, visible solo para vos."), ("Elegí cada detalle", "En Diseño y módulos podés agregar secciones, cambiar su orden con las flechas y ocultarlas con el interruptor. Guardá los cambios antes de abrir la vista previa."), ("Marcá dónde nos encontramos", "En Lugar y horario buscá el lugar y elegí una sugerencia de Google Maps, cuando la búsqueda esté habilitada. Revisá el mapa, escribí los detalles y guardá. También podés ingresar una dirección o pegar un enlace. Sumá otro módulo para separar la ceremonia de la fiesta."), ("Dale vida con tus fotos", "Arrastrá imágenes a la Galería o elegilas desde tu celular. También podés tomar una foto. Editá sus descripciones, ordenalas y elegí una para la portada."), ("Compartí la emoción", "En Configuración, revisá la fecha, la zona horaria y el enlace. Publicá cuando esté lista: cualquier persona con el enlace podrá ver la invitación. Podés volver a borrador cuando quieras."), ("Recibí a tus personas favoritas", "Activá el módulo Confirmar asistencia. Las respuestas y la cantidad de asistentes aparecerán en Respuestas. El mismo correo no puede enviar dos confirmaciones."), ("Todo tiene su lugar", "Si eliminás un evento, irá a la papelera de Mis eventos y se dejará de publicar. Podés restaurarlo como borrador. Las fotos eliminadas individualmente no se recuperan.")]; }
