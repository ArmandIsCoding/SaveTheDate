@page "/registro"
@layout PublicLayout
<PageTitle>Crear cuenta · SaveTheDate</PageTitle>
<div class="auth-page"><section class="auth-story watercolor"><a class="brand" href="/"><img src="/images/brand.svg" alt="" /><span>save<span class="brand-italic">the</span>date.</span></a><div class="auth-story-content"><span class="eyebrow">EL COMIENZO DE ALGO LINDO</span><h1>Hay momentos<br />que merecen<br /><em>su propio lugar.</em></h1><p>Una boda, un cumpleaños, un nuevo comienzo.<br />Creá una invitación tan especial como tu historia.</p><div class="auth-photo"><img src="/images/dinner.jpg" alt="Una mesa preparada para celebrar" /><span>que nunca nos falten motivos para brindar ♡</span></div></div></section><section class="auth-form-wrap"><div class="auth-form"><span class="eyebrow">BIENVENIDO A SAVETHEDATE</span><h2>Empecemos a celebrar.</h2><p>Creá tu cuenta y dale forma a tu primer evento.</p>
@if (!string.IsNullOrEmpty(Error)) { <div class="notice error" role="alert">@Error</div> }
<form method="post" action="/cuenta/registrar" data-enhance="false"><AntiforgeryToken /><label>Tu nombre<input name="name" autocomplete="given-name" required minlength="2" maxlength="80" placeholder="¿Cómo te llamás?" /></label><label>Correo electrónico<input type="email" name="email" autocomplete="email" required maxlength="200" placeholder="vos@ejemplo.com" /></label><label>Contraseña<input type="password" name="password" autocomplete="new-password" required minlength="10" maxlength="128" placeholder="Al menos 10 caracteres" /></label><label>Repetí la contraseña<input type="password" name="confirm" autocomplete="new-password" required minlength="10" maxlength="128" placeholder="Una vez más" /></label><button class="button primary wide" type="submit">Crear mi espacio <Icon Name="arrow" /></button></form><p class="auth-switch">¿Ya tenés cuenta? <a href="/ingresar">Ingresar</a></p></div></section></div>
@code { [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; } }
