@page "/eventos/{Id:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject EventService Events
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<EventEditor> Logger
<PageTitle>@(item?.Title ?? "Tu evento") · SaveTheDate</PageTitle>
<NavigationLock ConfirmExternalNavigation="@HasChanges" OnBeforeInternalNavigation="BeforeNavigation" />
<header class="topbar"><div class="breadcrumb"><a href="/eventos">Mis eventos</a> <span>/</span> <strong>@(item?.Title ?? "Editor")</strong></div><a class="text-button" href="/ayuda">Una mano con tu evento <Icon Name="help" /></a></header>
<div class="page-content editor-page" id="page-content">
@if (item is null) { <div class="empty-state"><h1>@(loading ? "Preparando tu historia…" : "No encontramos este evento")</h1><a href="/eventos">Volver a mis eventos</a></div> }
else
{
    <section class="page-heading editor-heading"><div><a class="back-link" href="/eventos"><Icon Name="back" /> Mis eventos</a><h1>@item.Title</h1><div class="editor-meta"><span class="status-badge @(item.IsPublished ? "published" : "draft")">@(item.IsPublished ? "Publicado" : "Borrador")</span><span>@ModuleCatalog.KindName(item.Kind) · @localDate.ToString("d 'de' MMMM, yyyy")</span></div></div><div class="heading-actions"><a class="button secondary" href="/eventos/@Id/vista-previa" target="_blank" title="Vista de la última versión guardada"><Icon Name="eye" /> Vista previa</a><button class="button primary" @onclick="Save" disabled="@busy"><Icon Name="check" /> @(busy ? "Guardando…" : "Guardar cambios")</button></div></section>
    <div class="editor-tabs tabs"><button class="@(tab == "design" ? "active" : "")" @onclick='() => tab = "design"'><Icon Name="sparkles" /> Diseño y módulos</button><button class="@(tab == "gallery" ? "active" : "")" @onclick='() => tab = "gallery"'><Icon Name="image" /> Galería</button><button class="@(tab == "guests" ? "active" : "")" @onclick='() => tab = "guests"'><Icon Name="users" /> Respuestas <span>@item.Responses.Count</span></button><button class="@(tab == "settings" ? "active" : "")" @onclick='() => tab = "settings"'><Icon Name="calendar" /> Configuración</button><span class="save-state">@(HasChanges ? "Cambios sin guardar" : "Todo guardado")</span></div>
    @if (message is not null) { <div class="notice @(failed ? "error" : "success")" role="status">@message</div> }
    @if (tab == "design")
    {
        <div class="editor-grid"><section class="module-editor"><div class="section-title"><div><h2>Tu invitación, pieza a pieza</h2><p>Elegí qué contar y en qué orden.</p></div><button class="button secondary small" @onclick="() => showCatalog = true"><Icon Name="plus" /> Agregar módulo</button></div>
        <div class="palette-picker"><span>El color de tu historia</span><div role="group" aria-label="Paleta de colores">@foreach (var palette in palettes) { <button title="@palette.Value" aria-label="@palette.Value" aria-pressed="@(item.Palette == palette.Key)" class="palette-swatch @palette.Key @(item.Palette == palette.Key ? "selected" : "")" @onclick="() => item.Palette = palette.Key">@if (item.Palette == palette.Key) { <Icon Name="check" /> }</button> }</div><small>@palettes[item.Palette]</small></div>
        <div class="module-list">@foreach (var module in item.Modules.OrderBy(x => x.Position))
        {
            var definition = ModuleCatalog.Get(module.Kind);
            <article class="module-card @(selected == module.Id ? "expanded" : "") @(!module.Enabled ? "disabled-module" : "")" @key="module.Id"><div class="module-row"><span class="module-icon"><Icon Name="@definition.Icon" /></span><button class="module-select" @onclick="() => selected = selected == module.Id ? null : module.Id"><strong>@definition.Name</strong><small>@(module.Enabled ? module.Title : "Oculto en tu invitación")</small></button><div class="module-order"><button class="icon-button" title="Subir módulo" aria-label="Subir @definition.Name" disabled="@(module.Position == 0)" @onclick="() => Move(module, -1)"><Icon Name="up" /></button><button class="icon-button" title="Bajar módulo" aria-label="Bajar @definition.Name" disabled="@(module.Position == item.Modules.Count - 1)" @onclick="() => Move(module, 1)"><Icon Name="down" /></button></div><label class="switch" title="Mostrar módulo"><input type="checkbox" @bind="module.Enabled" aria-label="Mostrar @definition.Name" /><span></span></label></div>
            @if (selected == module.Id) { <div class="module-fields"><label>Título<input @bind="module.Title" maxlength="120" /></label>@if (module.Kind != ModuleKind.Countdown && module.Kind != ModuleKind.Gallery) { <label>Texto<textarea @bind="module.Body" rows="3" maxlength="4000" placeholder="Contálo con tus palabras…"></textarea></label> }@if (module.Kind is ModuleKind.Location or ModuleKind.Gifts or ModuleKind.Information or ModuleKind.DressCode) { <label>Detalles<textarea @bind="module.Detail" rows="2" maxlength="500" placeholder="Horario, dirección o información adicional"></textarea></label> }@if (module.Kind == ModuleKind.Location) { <LocationEditor Module="module" OnChanged="StateHasChanged" /> }@if (module.Kind is ModuleKind.Gifts or ModuleKind.Music or ModuleKind.Social or ModuleKind.Information) { <div class="form-row"><label>Texto del botón<input @bind="module.ButtonText" maxlength="80" placeholder="Ver más" /></label><label>Enlace (https://)<input type="url" @bind="module.LinkUrl" maxlength="1000" placeholder="https://…" /></label></div> }@if (module.Kind == ModuleKind.Header) { <p class="field-hint">El nombre y la fecha se editan en Configuración. Elegí una foto de portada desde Galería.</p> }@if (module.Kind == ModuleKind.Gallery) { <button class="text-button" @onclick='() => tab = "gallery"'>Administrar las fotos de este evento <Icon Name="arrow" /></button> }@if (module.Kind == ModuleKind.Rsvp) { <p class="field-hint">Incluye un formulario de asistencia. Las respuestas aparecen en la pestaña Respuestas.</p> }@if (module.Kind is not (ModuleKind.Header or ModuleKind.Gallery)) { <button class="text-button danger" @onclick="() => Remove(module)"><Icon Name="trash" /> Quitar módulo</button> }</div> }</article>
        }</div><button class="add-module" @onclick="() => showCatalog = true"><Icon Name="plus" /> Un detalle más para tu historia</button></section>
        <aside class="preview-column"><div class="preview-label"><span><span class="status-dot"></span> ASÍ SE VA A VER</span><span>Vista de diseño</span></div><div class="phone-preview theme-@item.Palette"><div class="phone-speaker"></div><div class="mini-hero"><img src="@item.CoverUrl" alt="Vista de portada" /><div class="mini-hero-text"><span>@item.Modules.FirstOrDefault(x => x.Kind == ModuleKind.Header)?.Title</span><h2>@item.Title</h2><p>@localDate.ToString("dd . MM . yyyy")</p><span>♡</span></div></div><div class="mini-body"><span class="eyebrow">UNA FECHA PARA RECORDAR</span><h3>Nos espera algo hermoso</h3><div class="mini-count"><strong>@Math.Max(0, (localDate.Date - DateTime.Today).Days)</strong><span>días para celebrar</span></div><img src="/images/botanical.svg" alt="" /><p>@item.Modules.FirstOrDefault(x => x.Kind == ModuleKind.Story && x.Enabled)?.Title</p><span class="mini-footer">HECHO CON AMOR · SAVETHEDATE</span></div></div><p class="preview-caption">La vista completa muestra tus módulos en el orden elegido.<br />Guardá los cambios antes de abrirla.</p></aside></div>
    }
    else if (tab == "gallery") { <GalleryManager EventId="Id" OnChanged="GalleryChanged" /> }
    else if (tab == "guests")
    {
        <section class="panel"><div class="section-title"><div><h2>Las personas que hacen la historia</h2><p>@item.Responses.Where(x => x.Attending).Sum(x => x.PartySize) asistentes confirmados · @item.Responses.Count(x => !x.Attending) respuestas negativas</p></div><button class="button secondary small" @onclick="RefreshResponses"><Icon Name="users" /> Actualizar</button></div>@if (item.Responses.Count == 0) { <div class="empty-state"><span class="large-icon"><Icon Name="users" /></span><h3>Las mejores historias se comparten</h3><p>Publicá tu invitación con el módulo de asistencia activo.<br />Las respuestas de tus invitados aparecerán acá.</p></div> } else { <div class="table-scroll"><table><thead><tr><th>Invitado</th><th>Correo</th><th>Asistencia</th><th>Personas</th><th>Mensaje</th></tr></thead><tbody>@foreach (var guest in item.Responses.OrderByDescending(x => x.UpdatedAtUtc)) { <tr><td>@guest.Name</td><td>@guest.Email</td><td><span class="status-badge @(guest.Attending ? "published" : "draft")">@(guest.Attending ? "Confirmado" : "No asiste")</span></td><td>@(guest.Attending ? guest.PartySize : 0)</td><td>@guest.Note</td></tr> }</tbody></table></div> }</section>
    }
    else if (tab == "settings")
    {
        <div class="settings-grid"><section class="panel"><h2>Los detalles esenciales</h2><p>Un nombre, una fecha y un lugar para encontrarse.</p><label>Nombre del evento<input @bind="item.Title" maxlength="100" /></label><div class="form-row"><label>Celebración<select @bind="item.Kind">@foreach (var kind in Enum.GetValues<EventKind>()) { <option value="@kind">@ModuleCatalog.KindName(kind)</option> }</select></label><label>Fecha y hora<input type="datetime-local" @bind="localDate" /></label></div><label>Zona horaria<select @bind="item.TimeZoneId"><option value="America/Argentina/Cordoba">Argentina · Córdoba / Buenos Aires</option><option value="America/Montevideo">Uruguay · Montevideo</option><option value="America/Santiago">Chile · Santiago</option><option value="America/Mexico_City">México · Ciudad de México</option><option value="Europe/Madrid">España · Madrid</option><option value="UTC">UTC</option></select></label><label>Lugar del evento<input @bind="item.Venue" maxlength="160" placeholder="Nombre del lugar y ciudad" /></label><label>Enlace de tu invitación<div class="input-prefix"><span>/i/</span><input @bind="item.Slug" maxlength="100" /></div></label><p class="field-hint">Si cambiás el enlace, el anterior dejará de funcionar.</p></section><div><section class="panel publication-panel"><span class="panel-icon"><Icon Name="globe" /></span><h2>@(item.IsPublished ? "Tu historia ya se comparte" : "¿Todo listo para compartir?")</h2><p>@(item.IsPublished ? "Cualquier persona con el enlace puede ver tu invitación y sus fotos." : "Publicá tu invitación cuando cada detalle esté como lo imaginaste.")</p>@if (item.IsPublished) { <a class="public-url" href="/i/@item.Slug" target="_blank">/i/@item.Slug <Icon Name="arrow" /></a><button class="button secondary wide" @onclick="CopyLink"><Icon Name="link" /> Copiar enlace guardado</button><button class="text-button" @onclick="() => Publish(false)">Volver a borrador</button> } else { <button class="button primary wide" @onclick="() => Publish(true)" disabled="@busy"><Icon Name="globe" /> Publicar invitación</button> }</section><section class="danger-panel"><h3>Eliminar evento</h3><p>Se moverá a la papelera y su invitación dejará de estar disponible. Podrás restaurarlo.</p><button class="text-button danger" @onclick="() => confirmDelete = true"><Icon Name="trash" /> Mover a la papelera</button></section></div></div>
    }
}
</div>
@if (showCatalog && item is not null) { <div class="modal-backdrop"><section class="modal catalog-modal" role="dialog" aria-modal="true" aria-labelledby="catalog-title"><button class="modal-close icon-button" @onclick="() => showCatalog = false" aria-label="Cerrar"><Icon Name="close" /></button><span class="eyebrow">UN MUNDO DE POSIBILIDADES</span><h2 id="catalog-title">Cada detalle cuenta.</h2><p>Sumá nuevas piezas a tu invitación.</p><div class="catalog-grid">@foreach (var definition in ModuleCatalog.All.Where(d => d.Kind == ModuleKind.Location || !item.Modules.Any(m => m.Kind == d.Kind))) { <button @onclick="() => Add(definition.Kind)"><span class="module-icon"><Icon Name="@definition.Icon" /></span><strong>@definition.Name</strong><small>@definition.Description</small><Icon Name="plus" /></button> }</div></section></div> }
@if (confirmDelete) { <div class="modal-backdrop"><section class="modal compact" role="dialog" aria-modal="true" aria-labelledby="delete-title"><h2 id="delete-title">¿Mover a la papelera?</h2><p>La invitación dejará de estar publicada. Los datos y las fotos se conservarán para que puedas restaurarla.</p><div class="heading-actions"><button class="button secondary" @onclick="() => confirmDelete = false">Conservar evento</button><button class="button danger-button" @onclick="Delete">Mover a la papelera</button></div></section></div> }
@code {
    [Parameter] public Guid Id { get; set; }
    Celebration? item;
    DateTime localDate;
    string tab = "design", snapshot = "";
    string? message;
    Guid? selected;
    bool loading = true, busy, failed, showCatalog, confirmDelete, leaving;
    readonly Dictionary<string, string> palettes = new() { ["rose"] = "Rosa acuarela", ["sage"] = "Jardín de salvia", ["lavender"] = "Sueño lavanda" };
    string Fingerprint() => item is null ? "" : System.Text.Json.JsonSerializer.Serialize(new { item.Title, item.Slug, item.Kind, item.TimeZoneId, item.Venue, item.Palette, item.Modules, localDate });
    bool HasChanges => item is not null && !leaving && snapshot != Fingerprint();
    protected override async Task OnParametersSetAsync() { item = await Events.GetAsync(Id); loading = false; if (item is not null) { localDate = item.LocalDate; selected = item.Modules.OrderBy(x => x.Position).FirstOrDefault()?.Id; snapshot = Fingerprint(); } }
    async Task BeforeNavigation(LocationChangingContext context) { if (HasChanges && !await JS.InvokeAsync<bool>("confirm", "Tenés cambios sin guardar. ¿Querés salir de todos modos?")) context.PreventNavigation(); }
    async Task<bool> SaveCore() { if (item is null || busy) return false; busy = true; failed = false; try { await Events.SaveAsync(item, localDate); snapshot = Fingerprint(); message = "Todo guardado. Tu historia está un paso más cerca."; return true; } catch (Exception ex) { Logger.LogWarning(ex, "Saving event failed"); failed = true; message = ex is ValidationException ? ex.Message : "No pudimos guardar. Recargá el evento y volvé a intentar."; return false; } finally { busy = false; } }
    async Task Save() => await SaveCore();
    async Task Publish(bool value) { if (item is null) return; var previous = item.IsPublished; item.IsPublished = value; if (!await SaveCore()) item.IsPublished = previous; else message = value ? "Tu invitación está publicada. Ya podés compartir el enlace." : "Tu evento volvió a borrador."; }
    void Move(EventModule module, int direction) { if (item is null) return; var list = item.Modules.OrderBy(x => x.Position).ToList(); var from = list.IndexOf(module); var to = Math.Clamp(from + direction, 0, list.Count - 1); list.RemoveAt(from); list.Insert(to, module); for (var i = 0; i < list.Count; i++) list[i].Position = i; }
    void Remove(EventModule module) { item!.Modules.Remove(module); var i = 0; foreach (var m in item.Modules.OrderBy(x => x.Position)) m.Position = i++; }
    void Add(ModuleKind kind) { var module = ModuleCatalog.Create(kind, item!.Modules.Count); item.Modules.Add(module); selected = module.Id; showCatalog = false; }
    async Task GalleryChanged() { var fresh = await Events.GetAsync(Id); if (item is null || fresh is null) return; item.Gallery = fresh.Gallery; item.CoverImageId = fresh.CoverImageId; }
    async Task RefreshResponses() { var fresh = await Events.GetAsync(Id); if (item is not null && fresh is not null) item.Responses = fresh.Responses; }
    async Task CopyLink() { var saved = await Events.GetAsync(Id); if (saved is null) return; try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", Navigation.BaseUri + "i/" + saved.Slug); message = "Enlace copiado. ¡A compartir!"; failed = false; } catch (JSException) { message = "Copiá el enlace desde la barra de direcciones de tu invitación."; } }
    async Task Delete() { try { await Events.SetDeletedAsync(Id, true); leaving = true; Navigation.NavigateTo("/eventos"); } catch (Exception ex) { Logger.LogWarning(ex, "Delete failed"); message = "No pudimos mover el evento. Volvé a intentar."; failed = true; confirmDelete = false; } }
}
