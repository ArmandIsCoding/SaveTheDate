@inject GalleryService Gallery
@inject EventService Events
@inject ILogger<GalleryManager> Logger
<section class="panel gallery-panel"><div class="section-title"><div><h2>Una colección de instantes</h2><p>Las fotos que hacen única tu historia. @photos.Count de 100 imágenes.</p></div><span class="pill subtle"><Icon Name="image" /> Galería del evento</span></div>
<div class="upload-area"><div class="upload-symbol"><Icon Name="upload" /></div><h3>@(busy ? "Preparando tus recuerdos…" : "Arrastrá tus fotos hasta acá")</h3><p>o tocá para elegirlas desde tu dispositivo</p><span class="button secondary small">Elegir fotos</span><small>JPG, PNG o WebP · Hasta 10 MB por foto · 20 por carga</small><InputFile OnChange="Upload" multiple accept="image/jpeg,image/png,image/webp" aria-label="Elegir o arrastrar fotos" disabled="@busy" /></div><div class="camera-row"><span>¿El momento está pasando ahora?</span><label class="camera-button"><Icon Name="camera" /> Tomar una foto<InputFile OnChange="Upload" accept="image/*" capture="environment" aria-label="Tomar una foto con la cámara" disabled="@busy" /></label></div>
@if (message is not null) { <div class="notice @(failed ? "error" : "success")" role="status">@message</div> }
@if (photos.Count == 0) { <div class="empty-state"><h3>Los recuerdos empiezan con la primera foto.</h3><p>Cargá una imagen para empezar a contar tu historia.</p></div> }
else { <div class="gallery-admin-grid">@foreach (var photo in photos.OrderBy(x => x.Position)) { <article class="photo-card" @key="photo.Id"><div class="photo-image"><img src="/media/@photo.Id" alt="@photo.Caption" loading="lazy" />@if (coverId == photo.Id) { <span class="event-status published">Foto de portada</span> }</div><div class="photo-fields"><label>Descripción de la foto<input @bind="photo.Caption" maxlength="180" placeholder="Un instante para recordar" /></label><div class="photo-actions"><button class="icon-button" title="Guardar descripción" aria-label="Guardar descripción de @photo.Caption" disabled="@busy" @onclick="() => Update(photo)"><Icon Name="check" /></button><button class="icon-button" title="Mover antes" aria-label="Mover foto antes" disabled="@(busy || photo.Position == 0)" @onclick="() => Update(photo, -1)"><Icon Name="up" /></button><button class="icon-button" title="Mover después" aria-label="Mover foto después" disabled="@(busy || photo.Position == photos.Count - 1)" @onclick="() => Update(photo, 1)"><Icon Name="down" /></button><button class="text-button" disabled="@busy" @onclick="() => SetCover(photo.Id)">Usar de portada</button><button class="icon-button danger" title="Eliminar foto" aria-label="Eliminar foto" disabled="@busy" @onclick="() => pendingDelete = photo.Id"><Icon Name="trash" /></button></div></div></article> }</div> }
<p class="field-hint">Las fotos se optimizan y se eliminan los metadatos de ubicación. Si tu celular entrega una imagen HEIC, exportala como JPG antes de subirla. Los cambios de la galería se guardan en el momento.</p></section>
@if (pendingDelete.HasValue) { <div class="modal-backdrop"><section class="modal compact" role="dialog" aria-modal="true" aria-labelledby="photo-delete"><h2 id="photo-delete">¿Eliminar esta foto?</h2><p>Se quitará de la galería y de la portada si la estabas usando. Esta acción no se puede deshacer.</p><div class="heading-actions"><button class="button secondary" @onclick="() => pendingDelete = null">Conservar foto</button><button class="button danger-button" @onclick="Delete">Eliminar foto</button></div></section></div> }
@code {
    [Parameter] public Guid EventId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    List<GalleryImage> photos = [];
    Guid? coverId, pendingDelete;
    bool busy, failed;
    string? message;
    protected override async Task OnParametersSetAsync() => await Load();
    async Task Load() { var item = await Events.GetAsync(EventId); photos = item?.Gallery.Images.OrderBy(x => x.Position).ToList() ?? []; coverId = item?.CoverImageId; }
    async Task Upload(InputFileChangeEventArgs args) { if (busy) return; await Run(async () => { if (args.FileCount > 20) throw new ValidationException("Elegí hasta 20 fotos por vez."); var done = 0; foreach (var file in args.GetMultipleFiles(20)) { await using var stream = file.OpenReadStream(LocalImageStorage.MaxBytes); await Gallery.AddAsync(EventId, stream, Path.GetFileNameWithoutExtension(file.Name)); done++; message = $"{done} de {args.FileCount} fotos guardadas…"; await InvokeAsync(StateHasChanged); } message = $"{done} fotos se sumaron a tu historia."; }); }
    async Task Update(GalleryImage photo, int direction = 0) => await Run(async () => { await Gallery.UpdateAsync(EventId, photo.Id, photo.Caption, direction); message = "Foto actualizada."; });
    async Task SetCover(Guid id) => await Run(async () => { await Gallery.SetCoverAsync(EventId, id); message = "Tu invitación tiene una nueva portada."; });
    async Task Delete() { if (!pendingDelete.HasValue) return; var id = pendingDelete.Value; pendingDelete = null; await Run(async () => { await Gallery.DeleteAsync(EventId, id); message = "Foto eliminada de la galería."; }); }
    async Task Run(Func<Task> operation) { if (busy) return; busy = true; failed = false; try { await operation(); } catch (Exception ex) { Logger.LogWarning(ex, "Gallery operation failed"); failed = true; message = ex is ValidationException ? ex.Message : ex is IOException ? "La imagen es demasiado grande o no pudo leerse. El máximo es 10 MB." : "No pudimos completar la operación. Las fotos ya cargadas se conservaron."; } finally { await Load(); await OnChanged.InvokeAsync(); busy = false; } }
}
